# Seguridad Objetiva
plot_stackfrq(
dplyr::select(db_filtrado, peleas_calle,
asaltos, trafico_drogas),
show.prc = FALSE,
show.n = FALSE,
show.total = TRUE,
title = NULL) +
theme_ggdist()
# Seguridad Subjetiva
plot1 <- plot_stackfrq(
dplyr::select(db_filtrado, seguridad_perc),
show.prc = FALSE,
show.n = FALSE,
show.total = TRUE,
coord.flip = TRUE,
title = NULL
) +
theme_ggdist() +
labs(y = "Percepción de seguridad") +
theme(axis.title.x = element_blank())
