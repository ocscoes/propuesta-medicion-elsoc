library(readr)
library(DT)
library(dplyr)
# VERSIÓN ALTERNATIVA SIMPLE - Garantiza mostrar todas las columnas
crear_tabla_simple <- function(datos) {
datos_formateados <- formatear_categorias(datos)
datatable(datos_formateados,
options = list(
pageLength = 15,
scrollX = TRUE,
scrollY = "500px",
autoWidth = TRUE,
columnDefs = list(
list(width = "auto", targets = "_all"),
list(className = 'dt-body-left', targets = '_all')
)
),
filter = 'top',
class = 'cell-border stripe compact',
escape = FALSE
) %>%
formatStyle(columns = colnames(datos_formateados),
fontSize = '11px',
whiteSpace = 'normal')
}
crear_tabla_simple(datos)
