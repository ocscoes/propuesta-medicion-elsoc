format = "html",
caption = "Operacionalización de Variables") %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = FALSE,
position = "center",
font_size = 12
) %>%
column_spec(1, bold = TRUE, background = "#f8f9fa") %>%
scroll_box(width = "100%", height = "600px")
