"Desviación Estándar" = sd,
"Rango" = range,
"Histograma" = hist)
# 2. Calcular alfa de Cronbach de las 3 variables originales
alpha_part_pol <- psych::alpha(elsoc %>%
select(firma_peticion, asiste_marcha,
part_huelga))
cronbach_alpha3 <- round(alpha_part_pol$total$raw_alpha, 2)
# 3. Agregar columna con alfa de Cronbach (misma fila del índice)
t_part_pol <- t_part_pol %>%
mutate(`Alfa de Cronbach` = cronbach_alpha3)
# 4. Crear tabla formateada con kable()
tabla_part_pol <- t_part_pol %>%
kable(
format = "html",
caption = "Descriptivos del índice Participación política",
col.names = c("Variable", "Media", "DE", "Rango", "Distribución", "α"),
digits = 2,
align = c("l", "c", "c", "c", "c", "c")
) %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = FALSE,
font_size = 13,
position = "center"
) %>%
add_header_above(c(" " = 1, "Estadísticos descriptivos" = 4, " " = 1)) %>%
column_spec(1, bold = TRUE, width = "3cm") %>%
column_spec(2:3, width = "2cm") %>%
column_spec(4, width = "2.5cm") %>%
column_spec(5, width = "3cm") %>%
column_spec(6, width = "1.5cm")
# Mostrar tabla
tabla_part_pol
