# Versión alternativa si las categorías están separadas por otro delimitador
formatear_categorias_personalizado <- function(datos, delimitador = ";") {
# Buscar columnas que contengan categorías de respuesta
columnas_categorias <- grep("categor|respuesta|opcion|alternativa", colnames(datos), ignore.case = TRUE)
if(length(columnas_categorias) > 0) {
for(col in columnas_categorias) {
# Reemplazar el delimitador específico con salto de línea HTML
datos[[col]] <- gsub(delimitador, paste0(delimitador, "<br>"), datos[[col]])
}
}
return(datos)
}
# Crear tabla interactiva mejorada
datatable(datos,
# Opciones de visualización
options = list(
# Paginación
pageLength = 15,
lengthMenu = c(10, 15, 25, 50, 100),
# Búsqueda y filtrado
searchHighlight = TRUE,
search = list(regex = TRUE, caseInsensitive = TRUE),
# Scrolling y responsividad
scrollX = TRUE,
responsive = TRUE,
# Ordenamiento
order = list(list(0, 'asc')),
# Estilo de tabla
dom = 'Bfrtip',
buttons = c('copy', 'csv', 'excel', 'pdf'),
# Configuración de columnas
columnDefs = list(
list(className = 'dt-center', targets = '_all'),
list(width = '200px', targets = c(0, 1)),
list(width = '300px', targets = 2)
)
),
# Filtros por columna
filter = 'top',
# Configuración de display
class = 'cell-border stripe hover',
# Título de la tabla
caption = htmltools::tags$caption(
style = 'caption-side: top; text-align: center; font-size: 18px; font-weight: bold; margin-bottom: 10px;',
'Operacionalización de Variables'
),
# Configuración de extensiones
extensions = c('Buttons', 'Responsive')
) %>%
# Formateo adicional si es necesario
formatStyle(columns = colnames(datos)[1],
backgroundColor = '#f8f9fa',
fontWeight = 'bold') %>%
# Agregar estilo CSS personalizado
formatStyle(columns = colnames(datos),
fontSize = '12px',
lineHeight = '1.4')
View(formatear_categorias_personalizado)
