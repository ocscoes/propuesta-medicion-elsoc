# Función para generar resumen de las variables
generar_resumen <- function(datos) {
cat("=== RESUMEN DE VARIABLES ===\n")
cat("Total de variables:", nrow(datos), "\n")
cat("Columnas disponibles:", paste(colnames(datos), collapse = ", "), "\n")
if("Tipo" %in% colnames(datos)) {
cat("\nDistribución por tipo:\n")
print(table(datos$Tipo))
}
}
# Ejecutar resumen
generar_resumen(datos)
# Versión alternativa con kable + kableExtra para documentos estáticos
